          ],
          "additionalProperties": false
        },
        "max_ocr_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "include_controls": {
          "type": "boolean"
        },
        "max_controls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "control_point": {
          "type": "object",
          "properties": {
            "x": {
