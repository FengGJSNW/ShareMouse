  {
    "name": "get_control_status",
    "description": "Read the owned control-session summary without taking a screenshot, replacing observation_id, or renewing the lease. Returns busy state, latest observation_id, last action, foreground input state and remaining lease. Explicit user exit is not retryable without new user authorization.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "peer_id": {
          "type": "string",
          "minLength": 1
        },
        "control_session_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "peer_id",
        "control_session_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "computer_action",
    "description": "Execute an ordered batch, returning per-step results and a final observation. injected means OS injection, not application success. settle_ms adds a cancellable delay before the final screenshot. expected_window_id or require_same_window prevents accidental input to a changed foreground window; allow_window_change may explicitly permit an intentional switch. key_hold auto-releases after duration_ms. move_relative uses native input counts, does not press a button, and camera response depends on the application. All explicit timed actions plus settle_ms total at most 30000 ms. checkpoint_after returns before later actions run; issue remaining actions in a new request after review. step_images includes at most the first 3 steps as 320-pixel thumbnails. request_id deduplicates the complete semantic request; never blindly retry unknown execution. On user_exit, stop and await user authorization. Keys are case-insensitive: Delete/delete, Ctrl, A, F1. keypress presses then releases the chord. delta_y positive scrolls up, negative down; delta_x positive right. x/y and drag path are pixels of the latest image (including crops), never desktop pixels. Drag holds the chosen button over all path points. move_relative uses native input counts; app sensitivity varies. injected confirms OS injection only; application effects must be checked in the returned observation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "peer_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable peer_id from list_computers; use local for this computer."
        },
        "control_session_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional UUID for retry deduplication."
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "click"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "button": {
                    "enum": [
                      "left",
                      "right",
                      "middle"
                    ]
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "double_click"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "move"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "drag"
                  },
                  "path": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "button": {
                    "enum": [
                      "left",
                      "right",
                      "middle"
                    ]
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "scroll"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "delta_x": {
                    "type": "number"
                  },
                  "delta_y": {
                    "type": "number"
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y",
                  "delta_y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "keypress"
                  },
                  "keys": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "keys"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "type"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "wait"
                  },
                  "milliseconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 30000
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "milliseconds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "key_hold"
                  },
                  "keys": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "keys",
                  "duration_ms"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "move_relative"
                  },
                  "dx": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "dy": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5000
                  },
                  "steps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "allow_window_change": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "dx",
                  "dy"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "focus_application"
                  },
