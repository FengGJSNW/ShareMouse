{
  "manifest_version": 3,
  "name": "ShareMouse Browser Bridge",
  "version": "1.0.2",
  "minimum_chrome_version": "106",
  "description": "Explicit-tab DOM observations and semantic actions through the local ShareMouse native host.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "ShareMouse browser bridge: click to reconnect" }
}
